{
  "name": "flight-deck",
  "version": "0.5.2",
  "description": "Command-center readout pane: context fill, last turn I/O, tool calls, session clock and tokens",
  "types": "./types/index.d.ts",
  "author": {
    "name": "Kedar Vyas",
    "url": "https://github.com/kedarvyas"
  },
  "license": "MIT",
  "keywords": [
    "context",
    "tokens",
    "status",
    "band",
    "toast"
  ],
  "userConfig": {
    "toastAfterSeconds": {
      "type": "number",
      "title": "Long-turn toast after (seconds)",
      "description": "Toast when a turn runs at least this long. 0 turns the toast off.",
      "default": 60
    }
  },
  "icon": "./.claude-plugin/icon.png",
  "homepage": "https://github.com/kedarvyas/claude-flight-deck#readme",
  "repository": "https://github.com/kedarvyas/claude-flight-deck",
  "documentationUrl": "https://github.com/kedarvyas/claude-flight-deck#readme",
  "supportUrl": "https://github.com/kedarvyas/claude-flight-deck/issues",
  "privacyPolicyUrl": "https://github.com/kedarvyas/claude-flight-deck#privacy",
  "termsOfServiceUrl": "https://github.com/kedarvyas/claude-flight-deck/blob/main/LICENSE"
}
